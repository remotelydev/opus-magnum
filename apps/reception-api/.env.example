# 32-byte key as 64 hex chars. Generate with: openssl rand -hex 32
# Never commit the real value.
TRANSCRIPT_KEY=

# Optional. Default is apps/reception-api/transcripts (gitignored).
# TRANSCRIPTS_DIR=

# Cloudflare named-tunnel token from Zero Trust → Networks → Tunnels.
# cloudflared reads this as-is. Leave empty for a quick tunnel
# (random https://*.trycloudflare.com; URL changes every restart).
# Never commit the real value.
TUNNEL_TOKEN=

# Optional alias for TUNNEL_TOKEN (used only if TUNNEL_TOKEN is empty).
# CLOUDFLARE_TUNNEL_TOKEN=

# Optional. Origin the quick tunnel proxies to (named tunnels use the
# dashboard Service URL instead). Default: http://127.0.0.1:8788
# TUNNEL_ORIGIN=http://127.0.0.1:8788

# Meta WhatsApp Cloud API (outbound tickets to Bartosz). Never commit real values.
# Setup: https://developers.facebook.com/apps/ → app → Add product → WhatsApp
# → API Setup. Copy Phone number ID (test number) and a token.
# WHATSAPP_TO is Bartosz's personal WhatsApp, country code, e.g. +48500...
# Temporary dashboard tokens expire ~24h; use a System User token for longer tests.
# WHATSAPP_TO is also the only number allowed to confirm tickets with "OK".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=

# Optional Graph API version. Default: v22.0
# WHATSAPP_GRAPH_VERSION=v22.0

# Inbound webhook (staff "OK" replies). Callback URL in the Meta app:
# https://<named tunnel host>/webhooks/whatsapp, subscribed to the "messages" field.
# WHATSAPP_APP_SECRET: App settings → Basic → App secret (signs every POST).
# WHATSAPP_VERIFY_TOKEN: any random string; paste the same value in Meta.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# SMSAPI.pl confirmation SMS. Empty token: the SMS is logged, not sent.
SMSAPI_TOKEN=
# Optional sender name registered in SMSAPI (default sender if empty).
# SMSAPI_SENDER=

# Optional. Ticket store location. Default: apps/reception-api/data (gitignored).
# TICKETS_DIR=
