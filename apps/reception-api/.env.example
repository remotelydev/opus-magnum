# 32-byte key as 64 hex chars. Generate with: openssl rand -hex 32
# Never commit the real value.
TRANSCRIPT_KEY=

# Optional. Default is apps/reception-api/transcripts (gitignored).
# TRANSCRIPTS_DIR=

# Cloudflare named-tunnel token from Zero Trust → Networks → Tunnels.
# cloudflared reads this as-is. Leave empty for a quick tunnel
# (random https://*.trycloudflare.com; URL changes every restart).
# Never commit the real value.
TUNNEL_TOKEN=

# Optional alias for TUNNEL_TOKEN (used only if TUNNEL_TOKEN is empty).
# CLOUDFLARE_TUNNEL_TOKEN=

# Optional. Origin the quick tunnel proxies to (named tunnels use the
# dashboard Service URL instead). Default: http://127.0.0.1:8788
# TUNNEL_ORIGIN=http://127.0.0.1:8788
