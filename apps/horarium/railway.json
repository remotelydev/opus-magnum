{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/horarium/Dockerfile",
    "watchPatterns": ["apps/horarium/**", "packages/dentaplus-ui/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE"
  }
}
