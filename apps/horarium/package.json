{
  "name": "horarium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include .env src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx scripts/migrate.ts",
    "user:create": "tsx scripts/create-user.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "test": "TZ=Europe/Warsaw tsx --test src/**/*.test.ts web/src/**/*.test.ts",
    "lint": "tsc --noEmit && tsc --noEmit -p web"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@heroicons/react": "^2.2.0",
    "@opus-magnum/dentaplus-ui": "workspace:*",
    "fastify": "^5.12.7",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite": "^8.3.5"
  }
}
